6) Desenvolver um algoritmo que leia dez números inteiro e verifique e imprima quantos são divisíveis por 5 e por 3 ao mesmo tempo.  

RESPOSTA: 

#include <stdio.h> 

  

int main() { 

  

    int numero, i; 

    int contador = 0; 

    for(i = 1; i <= 10; i++) { 

        printf("Digite o %dº número: ", i); 

        scanf("%d", &numero); 

        if(numero % 5 == 0 && numero % 3 == 0) { 

            contador++; 

        } 

    } 

  

    printf("Quantidade de números divisíveis por 5 e 3 ao mesmo tempo: %d\n", contador); 

  

    return 0; 

} 
